# Platform Console Environment Variables

# CMS Service Base URL
# Production: https://cms.salehspace.dev
NEXT_PUBLIC_CMS_BASE_URL=http://localhost:8080

# CRM Service Base URL
# Production: https://crm.salehspace.dev
NEXT_PUBLIC_CRM_BASE_URL=http://localhost:4000

# IAM Authorization Service Base URL
NEXT_PUBLIC_IAM_BASE_URL=http://localhost:4003

# Auth mode: cms | bridge | iam
# bridge = IAM login + CMS token bridge for CMS/CRM API calls
NEXT_PUBLIC_AUTH_MODE=bridge

# Aggregation Service Base URL
# Production: https://wahb-broker.salehspace.dev
NEXT_PUBLIC_AGGREGATION_BASE_URL=http://localhost:5002

# Grafana URL for deep observability links
# Production: https://grafana.salehspace.dev
NEXT_PUBLIC_GRAFANA_URL=http://localhost:3002
